func TestHandlerWebhookMux_BadSignature(t *testing.T) {
	handler, _, _, _ := newTestHandler()

	r := chi.NewRouter()
	handler.Routes(r)

	body := bytes.NewBufferString(`{}`)
	req := httptest.NewRequest("POST", "/webhooks/mux", body)
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Mux-Signature", "t=2025-01-01T00:00:00Z,v1=badsig")
	w := httptest.NewRecorder()

	r.ServeHTTP(w, req)

	// Will fail due to bad timestamp or signature
	if w.Code < 400 {
		t.Errorf("expected error status, got %d", w.Code)
	}
}

