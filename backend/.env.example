# Copy to .env and fill in. Never commit .env.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:55432/zona?sslmode=disable
MIGRATE_ON_START=true
CORS_ALLOWED_ORIGINS=http://localhost:3000

# openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=zona-api
ACCESS_TOKEN_TTL=15m

# Own auth (/auth/*). APP_URL builds password-reset links (https in prod).
APP_URL=http://localhost:5173
# SMTP with STARTTLS; required in production. In development, reset emails
# are written to the API log instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Integrations (a module is disabled when its keys are empty) ---
# File storage: local disk (a Docker volume) unless an S3 bucket is set.
STORAGE_DIR=./data

# Storage (Wasabi / R2 / S3; optional, overrides STORAGE_DIR)
S3_ENDPOINT=https://s3.wasabisys.com
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Bucket policy: allow public reads ONLY on the league/, team/ and player/
# prefixes (logos, photos). player_document/ (identity documents) and
# app_releases/ must stay private; the API serves them with presigned URLs.

# WhatsApp notifications (Kapso)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_JORNADA=jornada_notification
WHATSAPP_TEMPLATE_RESULTADO_JORNADAS=resultado_jornadas
PUBLIC_SITE_URL=https://admin.zona-gol.com

# Zona Play (deferred). Off by default: /api/v1/play/* is not mounted (#51).
PLAY_ENABLED=false
# Zona Play video (Mux), only used when PLAY_ENABLED=true
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# AI knowledge base embeddings
OPENAI_API_KEY=

# AI assistant (OpenAI-compatible; Groq by default)
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Kapso webhook signing secret (enables POST /api/v1/agent/webhooks/kapso)
KAPSO_WEBHOOK_SECRET=
