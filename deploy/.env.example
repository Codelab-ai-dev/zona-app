# Copied to deploy/.env by `make env` with random secrets. Never commit .env.
APP_ENV=development
POSTGRES_PASSWORD=
JWT_SECRET=
# Public URL of the web (password-reset links). Production: https://your-domain
APP_URL=http://localhost:8088
# Local: listen on localhost:8088. Production: 0.0.0.0:80 plus a 443 mapping
# (see compose.prod.yml) and SITE_ADDRESS=your-domain.
HTTP_BIND=127.0.0.1:8088
SITE_ADDRESS=:80
# Demo accounts password (local only; `make seed`).
SEED_PASSWORD=

# Required in production (password reset). Locally, emails are printed in
# the API logs instead: `make logs`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional integrations (see backend/.env.example for the full list):
# S3_*, KAPSO_*, MUX_*, LLM_*, OPENAI_API_KEY
